# Search-engine ownership verification (optional, recommended for SEO).
# Paste the token value only — the meta tags are generated automatically.
# Set these in Vercel → Project → Settings → Environment Variables.

# Google Search Console → Settings → Ownership verification → HTML tag
# (use the value of the content="..." attribute)
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools → Site verification (the msvalidate.01 content value)
BING_SITE_VERIFICATION=
